{
  "concepts": ["project-scan"],
  "documents": [
    {
      "path": "docs/architecture.spec.md",
      "audience": "a developer extending the scanner",
      "question": "What does the scanner refuse, and on what evidence?"
    }
  ],
  "observables": [
    { "name": "exit_code", "type": "number" },
    { "name": "message", "type": "string" }
  ],
  "actions": [
    {
      "name": "run-scanner",
      "calls": { "kind": "symbol", "name": "parse_config", "from": "src/config.rs" },
      "produces": ["exit_code", "message"]
    }
  ],
  "fixtures": ["fixtures/empty-directory", "fixtures/populated-directory"],
  "harness": "veridoc-harness"
}
